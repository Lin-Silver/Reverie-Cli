{
  "schema_version": "2.0",
  "id": "blender",
  "display_name": "Blender Portable Plugin",
  "runtime_family": "dcc",
  "version": "0.6.0",
  "delivery": "python-exe",
  "description": "Portable Blender plugin with automatic RuiC Skill loading for source-preserving browser/OBS 2D avatars, local pose synchronization, illustration cards, and reference-guided humanoid authoring.",
  "entry": {
    "preferred": {
      "windows": "dist/reverie-blender.exe",
      "linux": "dist/reverie-blender",
      "darwin": "dist/reverie-blender"
    },
    "fallbacks": {
      "windows": "plugin.py",
      "linux": "plugin.py",
      "darwin": "plugin.py",
      "default": "plugin.py"
    },
    "strategy": "prefer-packaged",
    "allow_source_fallback": true
  },
  "packaging": {
    "format": "pyinstaller-onefile",
    "embedded_runtime": {
      "archive": "blender-5.1.1-windows-x64.zip",
      "deploy_command": "ensure_runtime",
      "runtime_dir": "runtime"
    },
    "compiled": {
      "windows": "dist/reverie-blender.exe",
      "linux": "dist/reverie-blender",
      "darwin": "dist/reverie-blender"
    },
    "source": {
      "default": "plugin.py"
    },
    "build": {
      "windows": [
        "build.bat"
      ],
      "default": [
        "python build_plugin.py"
      ]
    }
  },
  "capabilities": [
    "blender",
    "dcc",
    "modeling",
    "rigging",
    "baking",
    "export",
    "mmd",
    "pmx",
    "pmd",
    "vmd",
    "vpd",
    "addon-management",
    "scene-inspection",
    "ruic-card-skill",
    "2d-avatar",
    "obs-avatar",
    "illustration-to-3d",
    "holographic-cards",
    "2.5d-avatar",
    "humanoid-avatar-workflow"
  ]
}
